<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="theme-color" content="#1a1a2e">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Shell Command</title>
  <style>
    body { background: #1a1a2e; color: #eee; font-family: monospace; padding: 1em; overflow-x: hidden; }
    html { overflow-x: hidden; }
    .cmd-bar { display: flex; gap: 0.5em; align-items: center; margin-bottom: 0.5em; }
    .cmd-input { flex: 1; padding: 0.4em; font-size: 15px; border-radius: 4px; border: 1px solid #444; background: #16213e; color: #0f0; font-family: monospace; min-width: 0; }
    .output { width: 100%; min-height: 40vh; padding: 0.5em; background: #0a0a0a; border-radius: 4px; white-space: pre-wrap; word-break: break-all; overflow-wrap: break-word; font-size: 14px; box-sizing: border-box; }
    .block.error { color: #ff5252; font-weight: bold; }
    .btn { padding: 0.4em 1.2em; cursor: pointer; background: #0f3460; color: #eee; border: none; border-radius: 4px; white-space: nowrap; font-size: 14px; }
    .btn:hover { background: #16537e; }
    .btn:disabled { opacity: 0.5; cursor: not-allowed; }
  </style>
</head>
<body>
  <div class="cmd-bar">
    <input class="cmd-input" id="cmd" placeholder="输入命令，例如: ls" value="ls" autofocus>
    <button class="btn" id="runBtn" onclick="run()">执行</button>
    <button class="btn" onclick="clearOut()">清空</button>
  </div>
  <div class="output" id="output"></div>
  <script>
    const out = document.getElementById('output')
    const input = document.getElementById('cmd')
    const runBtn = document.getElementById('runBtn')
    let cmdRunning = false
    let currentCmdId = null   // 当前命令的唯一 ID

    // 命令历史（localStorage 持久化）
    const HIST_KEY = 'shellcmd_history'
    const HIST_MAX = 200
    let history = []
    let histIndex = -1       // -1 表示不在历史中；0..history.length-1 表示正在浏览第几条
    let draftBeforeHist = '' // 进入历史浏览前保存的当前输入草稿

    function loadHistory() {
      try {
        const raw = localStorage.getItem(HIST_KEY)
        history = raw ? JSON.parse(raw) : []
        if (!Array.isArray(history)) history = []
      } catch (e) {
        history = []
      }
    }
    function saveHistory() {
      try {
        localStorage.setItem(HIST_KEY, JSON.stringify(history.slice(-HIST_MAX)))
      } catch (e) {}
    }
    function pushHistory(cmd) {
      if (!cmd) return
      // 连续重复只保留一条
      if (history.length && history[history.length - 1] === cmd) return
      history.push(cmd)
      if (history.length > HIST_MAX) history = history.slice(-HIST_MAX)
      saveHistory()
    }
    function recallHistory(direction) {
      if (history.length === 0) return
      if (histIndex === -1) {
        // 第一次按 ↑/↓：先保存当前草稿
        draftBeforeHist = input.value
        histIndex = direction === 'up' ? history.length - 1 : 0
      } else {
        histIndex += direction === 'up' ? -1 : 1
      }
      if (histIndex < 0) {
        // 已经到顶了，再按 ↑ 回到草稿
        histIndex = -1
        input.value = draftBeforeHist
      } else if (histIndex >= history.length) {
        // 已经到底了，再按 ↓ 回到草稿
        histIndex = -1
        input.value = draftBeforeHist
      } else {
        input.value = history[histIndex]
      }
      // 光标移到末尾，便于继续编辑
      const len = input.value.length
      input.setSelectionRange(len, len)
    }

    loadHistory()

    // 页面加载时建立固定 SSE 通道
    const sseSid = 'shellcmd'
    const source = new EventSource('/sse/elecV2P/' + sseSid)
    source.onmessage = (e) => {
      try {
        const msg = JSON.parse(e.data)
        if (msg.type === 'shell') {
          if (msg.finish) {
            if (msg.id === currentCmdId) {
              // 命令结束：顶部显示完成消息
              const div = document.createElement('div')
              div.className = 'block finished'
              div.style.color = '#4fc3f7'
              div.textContent = '> ' + msg.cmd + ' —— 命令完成\n'
              out.insertBefore(div, out.firstChild)
              currentCmdId = null
            }
            cmdRunning = false
            runBtn.disabled = false
            runBtn.textContent = '执行'
          } else if (msg.data && msg.id === currentCmdId) {
            // 实时流式：每行 prepend 到顶部（最新输出在最上）
            const div = document.createElement('div')
            div.className = 'block live' + (msg.error ? ' error' : '')
            // 后端已转 ansi 为 span、且 escapeHtml 过；使用 innerHTML 渲染
            if (msg.html) {
              div.innerHTML = msg.html
            } else {
              div.textContent = msg.data
            }
            out.insertBefore(div, out.firstChild)
          }
        }
      } catch (err) {
        console.error('SSE parse error', err)
      }
    }
    source.onerror = () => {
      console.error('SSE error, readyState:', source.readyState)
    }

    function run() {
      if (cmdRunning) return
      const cmd = input.value.trim() || 'ls'
      input.value = ''
      cmdRunning = true
      runBtn.disabled = true
      runBtn.textContent = '运行中...'
      // 推入历史（已经会把连续重复去重）
      pushHistory(cmd)
      // 执行后重置历史浏览指针
      histIndex = -1
      draftBeforeHist = ''

      // 发送命令到后端，后端通过固定 sid 的 SSE 通道流式推送输出
      currentCmdId = Date.now()
      $fend('run', { cmd, sid: sseSid, id: currentCmdId }).then(res => res.text()).then(data => {
        // $fend 本身返回占位，实际输出通过 SSE
        if (data && data.trim() && data.trim() !== 'no output') {
          console.log('$fend result:', data)
        }
      }).catch(e => {
        const div = document.createElement('div')
        div.className = 'block live error'
        // 本地异常，安全起见走 textContent
        div.textContent = '> ' + cmd + '\n错误: ' + e
        out.insertBefore(div, out.firstChild)
        cmdRunning = false
        runBtn.disabled = false
        runBtn.textContent = '执行'
      })
    }

    input.addEventListener('keydown', e => {
      if (e.key === 'Enter') {
        e.preventDefault()
        run()
      } else if (e.key === 'ArrowUp') {
        e.preventDefault()
        recallHistory('up')
      } else if (e.key === 'ArrowDown') {
        e.preventDefault()
        recallHistory('down')
      }
    })

    function clearOut() {
      out.textContent = ''
    }
  </script>
</body>
</html>

<script favend runon="elecV2P">
  // === ANSI → HTML 转换（从 utils/ansi.js 内联）===
  // Author: https://t.me/elecV2
  const ANSI_COLORS = [
    "#0c0c0c","#c50f1f","#13a10e","#c19c00","#0037da","#881798","#3a96dd","#cccccc",
    "#767676","#e74856","#16c60c","#f9f1a5","#3b78ff","#b4009e","#61d6d6","#f2f2f2",
  ]
  const ANSI_C256_BASE = ["00","5f","87","af","d7","ff"]
  for (let x = 16; x < 232; x++) {
    ANSI_COLORS.push((x-16).toString(6).padStart(3,'0').split('').reduce((a,x)=>a+ANSI_C256_BASE[x],'#'))
  }
  ANSI_COLORS.push(...["#080808","#121212","#1c1c1c","#262626","#303030","#3a3a3a","#444444","#4e4e4e","#585858","#626262","#6c6c6c","#767676","#808080","#8a8a8a","#949494","#9e9e9e","#a8a8a8","#b2b2b2","#bcbcbc","#c6c6c6","#d0d0d0","#dadada","#e4e4e4","#eeeeee"])
  const ANSI_STYLE = new Map([
    ["0",""],["1","font-weight: bold;"],["2","opacity:0.5;"],["3","font-style: italic;"],
    ["4","text-decoration-line: underline;"],["5",""],["7","color: #0c0c0c; background-color: #767676"],
    ["8","display: none;"],["9","text-decoration-line: line-through;"],
    ["30",`color: ${ANSI_COLORS[0]};`],["90",`color: ${ANSI_COLORS[8]};`],
    ["31",`color: ${ANSI_COLORS[1]};`],["91",`color: ${ANSI_COLORS[9]};`],
    ["32",`color: ${ANSI_COLORS[2]};`],["92",`color: ${ANSI_COLORS[10]};`],
    ["33",`color: ${ANSI_COLORS[3]};`],["93",`color: ${ANSI_COLORS[11]};`],
    ["34",`color: ${ANSI_COLORS[4]};`],["94",`color: ${ANSI_COLORS[12]};`],
    ["35",`color: ${ANSI_COLORS[5]};`],["95",`color: ${ANSI_COLORS[13]};`],
    ["36",`color: ${ANSI_COLORS[6]};`],["96",`color: ${ANSI_COLORS[14]};`],
    ["37",`color: ${ANSI_COLORS[7]};`],["97",`color: ${ANSI_COLORS[15]};`],
    ["40",`background-color: ${ANSI_COLORS[0]};`],["100",`background-color: ${ANSI_COLORS[8]};`],
    ["41",`background-color: ${ANSI_COLORS[1]};`],["101",`background-color: ${ANSI_COLORS[9]};`],
    ["42",`background-color: ${ANSI_COLORS[2]};`],["102",`background-color: ${ANSI_COLORS[10]};`],
    ["43",`background-color: ${ANSI_COLORS[3]};`],["103",`background-color: ${ANSI_COLORS[11]};`],
    ["44",`background-color: ${ANSI_COLORS[4]};`],["104",`background-color: ${ANSI_COLORS[12]};`],
    ["45",`background-color: ${ANSI_COLORS[5]};`],["105",`background-color: ${ANSI_COLORS[13]};`],
    ["46",`background-color: ${ANSI_COLORS[6]};`],["106",`background-color: ${ANSI_COLORS[14]};`],
    ["47",`background-color: ${ANSI_COLORS[7]};`],["107",`background-color: ${ANSI_COLORS[15]};`],
  ])
  const ANSI_CLOSE = new Set(["","21","22","23","24","25","27","28","29","39","49"])
  function ansiStyle(strcode='') {
    if (!strcode) return ''
    let codes = strcode.split(';'), res=''
    for (let idx=0; idx<codes.length; idx++) {
      const c = codes[idx]
      if (ANSI_STYLE.has(c)) { res += ANSI_STYLE.get(c); continue }
      if (c === '38') {
        if (codes[idx+1]==='5' && codes[idx+2]) { res += `color: ${ANSI_COLORS[Number(codes[idx+2])]};`; idx+=2 }
        else if (codes[idx+1]==='2' && codes[idx+2] && codes[idx+3] && codes[idx+4]) {
          res += `color: rgb(${Number(codes[idx+2])}, ${Number(codes[idx+3])}, ${Number(codes[idx+4])});`; idx+=4
        }
        continue
      }
      if (c === '48') {
        if (codes[idx+1]==='5' && codes[idx+2]) { res += `background-color: ${ANSI_COLORS[Number(codes[idx+2])]};`; idx+=2 }
        else if (codes[idx+1]==='2' && codes[idx+2] && codes[idx+3] && codes[idx+4]) {
          res += `background-color: rgb(${Number(codes[idx+2])}, ${Number(codes[idx+3])}, ${Number(codes[idx+4])});`; idx+=4
        }
        continue
      }
    }
    return res
  }
  function ansiHtml(str) {
    if (!/(?:(?:\u001b\[)|\u009b)(?:(?:[0-9]{1,3})?(?:(?:;[0-9]{0,3})*)?[A-M|f-m])|\u001b[A-M]/.test(str)) return str
    let openTags = 0
    let ret = str.replace(/\033\[([\d;]*)([A-M|f-m])/g, (m, m1, m2) => {
      if (m2 !== 'm') return ''
      if (m1 === '0') {
        if (openTags > 0) { const ct = '</span>'.repeat(openTags); openTags = 0; return ct }
        return ''
      }
      if (ANSI_CLOSE.has(m1)) {
        if (openTags > 0) { openTags--; return '</span>' }
        return ''
      }
      openTags++
      if (ANSI_STYLE.has(m1)) return `<span style="${ANSI_STYLE.get(m1)}">`
      return `<span style="${ansiStyle(m1)}">`
    })
    if (openTags > 0) ret += '</span>'.repeat(openTags)
    return ret
  }

  // === HTML 转义（从 utils/string.js 内联）===
  function escapeHtml(str) {
    if (str == null) return ''
    return String(str)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;')
  }

  // 单条日志 ANSI → HTML 转换：先 escapeHtml 防 XSS，再把 ANSI 颜色码转为 <span style>
  function toHtmlLine(raw) {
    if (raw == null) return ''
    return ansiHtml(escapeHtml(String(raw)))
  }

  $fend('run', async data => {
    // data 格式: { cmd, sid, id }
    const { cmd, sid, id } = data
    let output = ''
    return new Promise((resolve) => {
      $exec(cmd, {
        from: 'eapp-shell',
        timeout: 30000,
        cb(data, error, finished) {
          if (error) {
            const html = toHtmlLine('ERROR: ' + error + '\n')
            $ws.sse(sid, { type: 'shell', id, data: 'ERROR: ' + error + '\n', html, error: true })
          } else if (data) {
            const line = data + '\n'
            const html = toHtmlLine(line)
            $ws.sse(sid, { type: 'shell', id, data: line, html })
            output += line
          }
          if (finished === true) {
            $ws.sse(sid, { type: 'shell', id, cmd, finish: true })
            resolve(output || 'no output')
          }
        }
      })
    })
  })
</script>